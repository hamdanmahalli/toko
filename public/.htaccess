<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # MIME untuk file PWA supaya diperlakukan sebagai manifest aplikasi.
    <IfModule mod_mime.c>
        AddType application/manifest+json .webmanifest
    </IfModule>

    # Batas waktu cache: berkas gambar biasa cukup disimpan satu jam, tetapi
    # berkas yang menentukan tampilan aplikasi (manifest, service worker,
    # icon utama) selalu divalidasi ulang supaya icon baru langsung terbaca.
    <IfModule mod_headers.c>
        <FilesMatch "\.(png|ico)$">
            Header set Cache-Control "max-age=3600, public"
        </FilesMatch>
        <FilesMatch "^(sw\.js|manifest\.webmanifest|apple-touch-icon\.png|favicon\.ico)$">
            Header set Cache-Control "no-cache, must-revalidate"
            Header unset Expires
            Header unset ETag
        </FilesMatch>
    </IfModule>

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
