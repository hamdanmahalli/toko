APP_NAME="Absensi Toko"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Ganti dengan URL produksi Anda (bisa subdomain domanesia), contoh:
# https://absen.namahosting.domanesia.com atau https://tokomm.online
APP_URL=https://tokomm.online
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Hosting ini menghadirkan PostgreSQL via cPanel > PostgreSQL Databases.
# Buat database + user lewat menu tersebut, lalu isi di bawah.
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=spmmaqna_tokomm
DB_USERNAME=spmmaqna_pg_admin
DB_PASSWORD="ISI_PASSWORD_POSTGRES_ANDA_DI_SINI"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=ssl
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
# Password aplikasi Gmail (bukan sandi akun): Google Account > Security >
# 2-Step Verification > App passwords. Wajib bila 2FA aktif.
MAIL_USERNAME="ISI_EMAIL_GMAIL_ANDA"
MAIL_PASSWORD="ISI_APP_PASSWORD_GMAIL"
MAIL_FROM_ADDRESS="ISI_EMAIL_GMAIL_ANDA"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"